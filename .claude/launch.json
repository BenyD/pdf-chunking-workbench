{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chunklab-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "3001"
      ],
      "cwd": "web",
      "port": 3001
    },
    {
      "name": "chunklab-worker",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "worker",
      "port": 8000
    }
  ]
}