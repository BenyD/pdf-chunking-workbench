{
  // The worker runs as a container on Cloudflare: this small Worker takes every request and hands it to
  // one long-lived container built from worker/Dockerfile. Secrets are set with `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chunklab-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },
  // A running container keeps the env it started with; bump GENERATION after changing a secret so a fresh one starts.
  // PURE: no generative model at any step (see worker/app/config.py). GENERATION 4 starts a container with it.
  "vars": { "GENERATION": "10", "PURE": "true" },
  "containers": [
    {
      "class_name": "ChunklabWorker",
      "image": "../../worker/Dockerfile",
      "max_instances": 2,
      // 2 vCPU: the local model embeds passages on the CPU. CPU is billed only while working; the 8 GiB of
      // memory costs about $0.07 an hour while the container is awake (Cloudflare pricing, 2026-10-18).
      "instance_type": "standard-3"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "ChunklabWorker", "name": "WORKER" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChunklabWorker"] }]
}
